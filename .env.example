# Copy to .env and fill in. Never commit .env.
# LLM backend: claude_cli (uses your local `claude` login, no key) or anthropic (needs ANTHROPIC_API_KEY)
LLM_BACKEND=claude_cli
ANTHROPIC_API_KEY=
# Models per stage (aliases haiku|sonnet|opus) - pass 1 cheap, second agent + adjudicator stronger
PASS1_MODEL=haiku
SECOND_MODEL=sonnet
ADJUDICATOR_MODEL=sonnet
WORKERS=6
# Optional: higher GitHub search rate limit for community-MCP discovery (gh auth token works)
GITHUB_TOKEN=
# Optional: Composio API key; enables SDK confirmation of toolkits (catalog lookup works without it)
COMPOSIO_API_KEY=
